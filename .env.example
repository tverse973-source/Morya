# Copy to .env.local for local dev. Never commit real secrets.
NEXT_PUBLIC_SITE_URL=https://www.moryatravels.in
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only (required for reliable admin/DB writes when RLS is enabled)
SUPABASE_SERVICE_ROLE_KEY=

# Required in production. Use a long random secret (32+ chars).
ADMIN_SESSION_SECRET=

# Phone notifications (optional). Configure any channel you use; you can enable multiple.
# ntfy (mobile push app): install ntfy, subscribe to a private topic.
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=

# Telegram (recommended for reliable phone alerts): create bot via @BotFather, message it, get chat id from getUpdates.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WhatsApp via CallMeBot (free; one-time activation required, not official WhatsApp Business API)
# Activate: https://www.callmebot.com/blog/free-api-whatsapp-messages/
WHATSAPP_NOTIFY_PHONE=
WHATSAPP_NOTIFY_APIKEY=

# WhatsApp via TextMeBot (complete activation first; 3-day test key as provided by TextMeBot)
# Activate: https://api.textmebot.com/addphone.php?apikey=YOUR_KEY
TEXTMEBOT_APIKEY=
TEXTMEBOT_WHATSAPP_PHONE=+91XXXXXXXXXX

# Generic webhook (Zapier/Make/official WhatsApp Business API gateway/SMS provider that accepts JSON POST).
NOTIFICATION_WEBHOOK_URL=
