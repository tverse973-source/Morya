# Production Environment Variables
# Copy to .env.local for local dev. Never commit real secrets.

NEXT_PUBLIC_SITE_URL=https://moryatravel.in
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key

# Server-only (Required for reliable admin/DB operations and bypassing RLS on server)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Required in production. Use a strong random secret (32+ chars).
ADMIN_SESSION_SECRET=generate-a-strong-32-char-random-session-secret

# Search Engine Verification (Optional)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# Multi-channel Notifications (Configure any channel you use)
# 1. Telegram (Recommended): BotFather bot token & chat ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. ntfy (Mobile push notifications)
NTFY_TOPIC=
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=

# 3. WhatsApp via CallMeBot (Free)
WHATSAPP_NOTIFY_PHONE=
WHATSAPP_NOTIFY_APIKEY=

# 4. WhatsApp via TextMeBot
TEXTMEBOT_APIKEY=
TEXTMEBOT_WHATSAPP_PHONE=+91XXXXXXXXXX

# 5. Generic Webhook (Zapier, Make, Slack, or SMS gateway)
NOTIFICATION_WEBHOOK_URL=
